# Meta Model API  -  https://llama.developer.meta.com
META_API_KEY=

# Where Muse Glimmer is served.
# "local"   = llama.cpp / vLLM on this machine
# "baseten" = partner inference
# "modal"   = partner inference
GLIMMER_BACKEND=local
GLIMMER_ENDPOINT=http://127.0.0.1:8080
GLIMMER_MODEL=muse-glimmer-30b

# Partner inference (only if GLIMMER_BACKEND is not local)
BASETEN_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Escalation tiers
SAM_MODEL=sam-3.1
SPARK_MODEL=muse-spark-1.2
WONDER_MODEL=muse-wonder-1.0
VOICE_MODEL=muse-voice-transcribe

# Sync
GROUNDTRUTH_SERVER=http://127.0.0.1:8000
DEVICE_ID=
